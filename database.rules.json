{
  "rules": {
    "data": {
      "catalog": {
        ".read": true,
        ".write": "auth != null && auth.token.slTransitRole === 'owner'"
      },
      "fleet": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.slTransitRole === 'owner'",
        "vehicles": {
          ".read": true
        }
      },
      "finance": {
        ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
        ".write": false
      },
      "erpDataCenter": {
        "workbookSource": {
          "manifest": {
            ".read": true,
            ".write": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true"
          },
          "routeFareRows": {
            ".read": true,
            ".write": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true"
          },
          "scheduleRows": {
            ".read": true,
            ".write": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true"
          }
        },
        "catalog": {
          ".read": true,
          ".write": "auth != null && auth.token.slTransitRole === 'owner'"
        },
        "fleet": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.slTransitRole === 'owner'",
          "vehicles": {
            ".read": true
          },
          "queues": {
            ".read": true
          }
        },
        "settings": {
          ".read": true,
          ".write": "auth != null && auth.token.slTransitRole === 'owner'"
        },
        "finance": {
          ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
          ".write": false
        },
        "adminAccounts": {
          ".read": "auth != null && auth.token.slTransitRole === 'owner'",
          "$uid": {
            ".write": false
          }
        }
      },
      "driverIdentityCenter": {
        "accounts": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      },
      "settings": {
        ".read": true,
        ".write": "auth != null && auth.token.slTransitRole === 'owner'"
      }
    },
    "operations": {
      "bookings": {
        ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
        ".write": false,
        ".indexOn": ["date", "serviceDate", "originKey", "destKey", "status", "ts", "cancelledAt", "refundedAt", "refundApprovedAt"],
        "$bookingId": {
          ".write": false
        }
      },
      "bookingCapacityByServiceDate": {
        "$serviceDate": {
          "$capacityKey": {
            ".read": false,
            ".write": false,
            "bookings": {
              "$bookingId": {
                ".validate": "newData.hasChildren(['seats', 'status', 'reservedAt']) && newData.child('seats').isNumber() && newData.child('seats').val() >= 1 && newData.child('seats').val() <= 10 && newData.child('status').val() === 'reserved'"
              }
            }
          }
        }
      },
      "publicBookingCapacityByServiceDate": {
        "$serviceDate": {
          "$capacityKey": {
            ".read": true,
            ".write": false,
            ".validate": "newData.hasChildren(['seatsAvailable', 'capacityStatus', 'bookingStatus', 'unavailable']) && !newData.hasChild('bookings') && !newData.hasChild('bookingIds') && !newData.hasChild('bookingCodes') && !newData.hasChild('reservationMarkers') && !newData.hasChild('counterPath')",
            "seatsAvailable": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "capacityStatus": {
              ".validate": "newData.isString() && (newData.val() === 'available' || newData.val() === 'limited' || newData.val() === 'full' || newData.val() === 'unavailable')"
            },
            "bookingStatus": {
              ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'closed' || newData.val() === 'unavailable')"
            },
            "unavailable": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      },
      "passengers": {
        ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
        ".write": false,
        "$passengerId": {
          ".write": false
        }
      },
      "liveVehicles": {
        ".read": true,
        "$vehicleId": {
          ".write": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId"
        }
      },
      "ticketLocations": {
        ".read": "auth != null",
        ".write": false
      },
      "driverLogs": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/role').val() === 'driver'"
      },
      "sosAlerts": {
        ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
        "$vehicleId": {
          ".write": "auth != null && (root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId || root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true)"
        }
      },
      "driverWorkByServiceDate": {
        "$serviceDate": {
          "$vehicleId": {
            ".read": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId",
            ".write": false
          }
        }
      },
      "driverTicketsByServiceDate": {
        "$serviceDate": {
          "$vehicleId": {
            ".read": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId",
            ".write": false
          }
        }
      },
      "refunds": {
        ".read": "auth != null && auth.token.slTransitRole === 'owner'",
        ".write": false,
        ".indexOn": ["refundStatus", "refundedAt", "refundRequestedAt", "refundReviewedAt", "refundApprovedAt", "refundProcessingStartedAt"]
      },
      "refundAudit": {
        ".read": "auth != null && auth.token.slTransitRole === 'owner'",
        ".write": false
      },
      "refundIdempotency": {
        ".read": false,
        ".write": false
      },
      "refundReferences": {
        ".read": false,
        ".write": false
      },
      "adminBookingAudit": {
        ".read": "auth != null && auth.token.slTransitRole === 'owner'",
        ".write": false
      }
    },
    "publishedSchedule": {
      ".read": true,
      ".write": "auth != null && auth.token.slTransitRole === 'owner'"
    },
    "bookings": {
      ".read": false,
      ".write": false,
      ".indexOn": ["date", "serviceDate", "originKey", "destKey", "status", "ts", "cancelledAt", "refundedAt", "refundApprovedAt"],
      "$bookingId": {
        ".write": false,
        "refundStatus": { ".write": false },
        "refundRequestedAt": { ".write": false },
        "refundApprovedAt": { ".write": false },
        "refundedAt": { ".write": false },
        "refundAmount": { ".write": false },
        "refundReference": { ".write": false },
        "refundUpdatedByUid": { ".write": false },
        "refundUpdatedByRole": { ".write": false },
        "adminCancelledByUid": { ".write": false },
        "adminCancelledByRole": { ".write": false }
      }
    },
    "analytics": {
      "mainWeb": {
        ".read": false,
        "$day": {
          ".indexOn": ["count", "pageViews"],
          ".validate": "$day.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
          "count": {
            ".read": true,
            ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
          },
          "pageViews": {
            ".read": true,
            ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
          },
          "pageDeviceCounts": {
            "$page": {
              ".read": true,
              ".write": "$page.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
            }
          },
          "devices": {
            "$deviceId": {
              ".read": true,
              ".write": "$deviceId.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['firstSeenAt', 'lastSeenAt', 'pageViews', 'pages']) && newData.child('firstSeenAt').isNumber() && newData.child('lastSeenAt').isNumber() && newData.child('lastSeenAt').val() >= newData.child('firstSeenAt').val() && newData.child('pageViews').isNumber() && ((!data.exists() && newData.child('pageViews').val() === 1) || (data.exists() && data.child('pageViews').isNumber() && newData.child('pageViews').val() === data.child('pageViews').val() + 1))",
              "pages": {
                "$page": {
                  ".validate": "$page.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isNumber() && newData.val() >= 1 && (!data.exists() || newData.val() === data.val() + 1)"
                }
              }
            }
          }
        }
      }
    },
    "driverCommands": {
      "$vehicleId": {
        "command": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.slTransitRole === 'owner' && (newData.val() === 'forceGpsRestart' || newData.val() === null)"
        },
        "lastResponse": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId"
        }
      }
    },
    "admin": {
      ".read": "auth != null && auth.token.slTransitRole === 'owner'",
      ".write": "auth != null && auth.token.slTransitRole === 'owner'"
    },
    "driverLogs": {
      ".read": false,
      "$vehicleId": {
        ".read": "auth != null && root.child('data/erpDataCenter/adminAccounts/' + auth.uid).val() === true",
        ".write": "auth != null && root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val() === $vehicleId"
      }
    },
    "ticketLocations": {
      ".read": false,
      "$bookingId": {
        ".read": true,
        ".write": false
      }
    },
    "passengerLiveLocations": {
      ".read": false,
      "$bookingId": {
        ".read": "auth != null && root.child('bookings/' + $bookingId + '/plannedVehicleId').val() === root.child('data/driverIdentityCenter/accounts/' + auth.uid + '/runtimeVehicleId').val()",
        ".write": false
      }
    },
    "meta": {
      ".read": true,
      ".write": false
    }
  }
}

