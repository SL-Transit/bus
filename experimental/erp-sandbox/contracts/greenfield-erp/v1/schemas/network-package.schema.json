{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://sl-transit.example/contracts/greenfield-erp/v1/network-package.schema.json",
    "title":  "SL-Transit Greenfield Network Package v1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "metadata",
                     "operators",
                     "locations",
                     "routes",
                     "journeyPatterns",
                     "serviceCalendars",
                     "fixedTrips",
                     "stopTimes",
                     "frequencyServices",
                     "fareProducts",
                     "fareRules",
                     "transferRules"
                 ],
    "properties":  {
                       "metadata":  {
                                        "$ref":  "#/$defs/metadata"
                                    },
                       "operators":  {
                                         "type":  "array",
                                         "items":  {
                                                       "$ref":  "#/$defs/operator"
                                                   }
                                     },
                       "locations":  {
                                         "type":  "array",
                                         "items":  {
                                                       "$ref":  "#/$defs/location"
                                                   }
                                     },
                       "routes":  {
                                      "type":  "array",
                                      "items":  {
                                                    "$ref":  "#/$defs/route"
                                                }
                                  },
                       "journeyPatterns":  {
                                               "type":  "array",
                                               "items":  {
                                                             "$ref":  "#/$defs/journeyPattern"
                                                         }
                                           },
                       "serviceCalendars":  {
                                                "type":  "array",
                                                "items":  {
                                                              "$ref":  "#/$defs/serviceCalendar"
                                                          }
                                            },
                       "fixedTrips":  {
                                          "type":  "array",
                                          "items":  {
                                                        "$ref":  "#/$defs/fixedTrip"
                                                    }
                                      },
                       "stopTimes":  {
                                         "type":  "array",
                                         "items":  {
                                                       "$ref":  "#/$defs/stopTime"
                                                   }
                                     },
                       "frequencyServices":  {
                                                 "type":  "array",
                                                 "items":  {
                                                               "$ref":  "#/$defs/frequencyService"
                                                           }
                                             },
                       "fareProducts":  {
                                            "type":  "array",
                                            "items":  {
                                                          "$ref":  "#/$defs/fareProduct"
                                                      }
                                        },
                       "fareRules":  {
                                         "type":  "array",
                                         "items":  {
                                                       "$ref":  "#/$defs/fareRule"
                                                   }
                                     },
                       "transferRules":  {
                                             "type":  "array",
                                             "items":  {
                                                           "$ref":  "#/$defs/transferRule"
                                                       }
                                         }
                   },
    "$defs":  {
                  "id":  {
                             "type":  "string",
                             "pattern":  "^[A-Z][A-Z0-9-]{2,63}$"
                         },
                  "date":  {
                               "type":  "string",
                               "pattern":  "^\\d{4}-\\d{2}-\\d{2}$"
                           },
                  "serviceTime":  {
                                      "type":  "string",
                                      "pattern":  "^(?:[0-3]?\\d|4[0-7]):[0-5]\\d:[0-5]\\d$"
                                  },
                  "metadata":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "packageId",
                                                    "schemaVersion",
                                                    "templateVersion",
                                                    "sourceChecksumSha256",
                                                    "mode",
                                                    "operatorScope",
                                                    "idempotencyKey"
                                                ],
                                   "properties":  {
                                                      "packageId":  {
                                                                        "$ref":  "#/$defs/id"
                                                                    },
                                                      "schemaVersion":  {
                                                                            "const":  "greenfield-erp-v1"
                                                                        },
                                                      "templateVersion":  {
                                                                              "type":  "string",
                                                                              "minLength":  1
                                                                          },
                                                      "sourceChecksumSha256":  {
                                                                                   "type":  "string",
                                                                                   "pattern":  "^sha256:[a-f0-9]{64}$"
                                                                               },
                                                      "mode":  {
                                                                   "const":  "validate_only"
                                                               },
                                                      "operatorScope":  {
                                                                            "type":  "array",
                                                                            "minItems":  1,
                                                                            "items":  {
                                                                                          "$ref":  "#/$defs/id"
                                                                                      }
                                                                        },
                                                      "idempotencyKey":  {
                                                                             "type":  "string",
                                                                             "minLength":  8,
                                                                             "maxLength":  128
                                                                         }
                                                  }
                               },
                  "operator":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "operatorId",
                                                    "nameTh",
                                                    "timezone"
                                                ],
                                   "properties":  {
                                                      "operatorId":  {
                                                                         "$ref":  "#/$defs/id"
                                                                     },
                                                      "nameTh":  {
                                                                     "type":  "string",
                                                                     "minLength":  1
                                                                 },
                                                      "timezone":  {
                                                                       "type":  "string",
                                                                       "minLength":  1
                                                                   }
                                                  }
                               },
                  "location":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "locationId",
                                                    "locationType",
                                                    "nameTh"
                                                ],
                                   "properties":  {
                                                      "locationId":  {
                                                                         "$ref":  "#/$defs/id"
                                                                     },
                                                      "locationType":  {
                                                                           "enum":  [
                                                                                        "station",
                                                                                        "stop",
                                                                                        "hub",
                                                                                        "depot",
                                                                                        "queuePoint"
                                                                                    ]
                                                                       },
                                                      "nameTh":  {
                                                                     "type":  "string",
                                                                     "minLength":  1
                                                                 },
                                                      "parentLocationId":  {
                                                                               "anyOf":  [
                                                                                             {
                                                                                                 "$ref":  "#/$defs/id"
                                                                                             },
                                                                                             {
                                                                                                 "type":  "null"
                                                                                             }
                                                                                         ]
                                                                           }
                                                  }
                               },
                  "route":  {
                                "type":  "object",
                                "additionalProperties":  false,
                                "required":  [
                                                 "routeId",
                                                 "operatorId",
                                                 "shortName",
                                                 "serviceMode"
                                             ],
                                "properties":  {
                                                   "routeId":  {
                                                                   "$ref":  "#/$defs/id"
                                                               },
                                                   "operatorId":  {
                                                                      "$ref":  "#/$defs/id"
                                                                  },
                                                   "shortName":  {
                                                                     "type":  "string",
                                                                     "minLength":  1
                                                                 },
                                                   "serviceMode":  {
                                                                       "enum":  [
                                                                                    "fixed",
                                                                                    "frequency",
                                                                                    "hybrid"
                                                                                ]
                                                                   }
                                               }
                            },
                  "journeyPattern":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "journeyPatternId",
                                                          "routeId",
                                                          "direction",
                                                          "stops"
                                                      ],
                                         "properties":  {
                                                            "journeyPatternId":  {
                                                                                     "$ref":  "#/$defs/id"
                                                                                 },
                                                            "routeId":  {
                                                                            "$ref":  "#/$defs/id"
                                                                        },
                                                            "direction":  {
                                                                              "enum":  [
                                                                                           "outbound",
                                                                                           "inbound",
                                                                                           "circular",
                                                                                           "other"
                                                                                       ]
                                                                          },
                                                            "stops":  {
                                                                          "type":  "array",
                                                                          "minItems":  2,
                                                                          "items":  {
                                                                                        "type":  "object",
                                                                                        "additionalProperties":  false,
                                                                                        "required":  [
                                                                                                         "stopSequence",
                                                                                                         "locationId"
                                                                                                     ],
                                                                                        "properties":  {
                                                                                                           "stopSequence":  {
                                                                                                                                "type":  "integer",
                                                                                                                                "minimum":  1
                                                                                                                            },
                                                                                                           "locationId":  {
                                                                                                                              "$ref":  "#/$defs/id"
                                                                                                                          }
                                                                                                       }
                                                                                    }
                                                                      }
                                                        }
                                     },
                  "serviceCalendar":  {
                                          "type":  "object",
                                          "additionalProperties":  false,
                                          "required":  [
                                                           "serviceCalendarId",
                                                           "startDate",
                                                           "endDate",
                                                           "weekdays"
                                                       ],
                                          "properties":  {
                                                             "serviceCalendarId":  {
                                                                                       "$ref":  "#/$defs/id"
                                                                                   },
                                                             "startDate":  {
                                                                               "$ref":  "#/$defs/date"
                                                                           },
                                                             "endDate":  {
                                                                             "$ref":  "#/$defs/date"
                                                                         },
                                                             "weekdays":  {
                                                                              "type":  "object",
                                                                              "additionalProperties":  false,
                                                                              "required":  [
                                                                                               "monday",
                                                                                               "tuesday",
                                                                                               "wednesday",
                                                                                               "thursday",
                                                                                               "friday",
                                                                                               "saturday",
                                                                                               "sunday"
                                                                                           ],
                                                                              "properties":  {
                                                                                                 "monday":  {
                                                                                                                "type":  "boolean"
                                                                                                            },
                                                                                                 "tuesday":  {
                                                                                                                 "type":  "boolean"
                                                                                                             },
                                                                                                 "wednesday":  {
                                                                                                                   "type":  "boolean"
                                                                                                               },
                                                                                                 "thursday":  {
                                                                                                                  "type":  "boolean"
                                                                                                              },
                                                                                                 "friday":  {
                                                                                                                "type":  "boolean"
                                                                                                            },
                                                                                                 "saturday":  {
                                                                                                                  "type":  "boolean"
                                                                                                              },
                                                                                                 "sunday":  {
                                                                                                                "type":  "boolean"
                                                                                                            }
                                                                                             }
                                                                          }
                                                         }
                                      },
                  "fixedTrip":  {
                                    "type":  "object",
                                    "additionalProperties":  false,
                                    "required":  [
                                                     "fixedTripId",
                                                     "routeId",
                                                     "journeyPatternId",
                                                     "serviceCalendarId",
                                                     "departureTime"
                                                 ],
                                    "properties":  {
                                                       "fixedTripId":  {
                                                                           "$ref":  "#/$defs/id"
                                                                       },
                                                       "routeId":  {
                                                                       "$ref":  "#/$defs/id"
                                                                   },
                                                       "journeyPatternId":  {
                                                                                "$ref":  "#/$defs/id"
                                                                            },
                                                       "serviceCalendarId":  {
                                                                                 "$ref":  "#/$defs/id"
                                                                             },
                                                       "departureTime":  {
                                                                             "$ref":  "#/$defs/serviceTime"
                                                                         }
                                                   }
                                },
                  "stopTime":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "stopTimeId",
                                                    "fixedTripId",
                                                    "stopSequence",
                                                    "locationId",
                                                    "arrivalTime",
                                                    "departureTime"
                                                ],
                                   "properties":  {
                                                      "stopTimeId":  {
                                                                         "$ref":  "#/$defs/id"
                                                                     },
                                                      "fixedTripId":  {
                                                                          "$ref":  "#/$defs/id"
                                                                      },
                                                      "stopSequence":  {
                                                                           "type":  "integer",
                                                                           "minimum":  1
                                                                       },
                                                      "locationId":  {
                                                                         "$ref":  "#/$defs/id"
                                                                     },
                                                      "arrivalTime":  {
                                                                          "$ref":  "#/$defs/serviceTime"
                                                                      },
                                                      "departureTime":  {
                                                                            "$ref":  "#/$defs/serviceTime"
                                                                        }
                                                  }
                               },
                  "frequencyService":  {
                                           "type":  "object",
                                           "additionalProperties":  false,
                                           "required":  [
                                                            "frequencyServiceId",
                                                            "routeId",
                                                            "journeyPatternId",
                                                            "serviceCalendarId",
                                                            "startTime",
                                                            "endTime",
                                                            "headwaySeconds",
                                                            "boardingModel",
                                                            "exactTimes"
                                                        ],
                                           "properties":  {
                                                              "frequencyServiceId":  {
                                                                                         "$ref":  "#/$defs/id"
                                                                                     },
                                                              "routeId":  {
                                                                              "$ref":  "#/$defs/id"
                                                                          },
                                                              "journeyPatternId":  {
                                                                                       "$ref":  "#/$defs/id"
                                                                                   },
                                                              "serviceCalendarId":  {
                                                                                        "$ref":  "#/$defs/id"
                                                                                    },
                                                              "startTime":  {
                                                                                "$ref":  "#/$defs/serviceTime"
                                                                            },
                                                              "endTime":  {
                                                                              "$ref":  "#/$defs/serviceTime"
                                                                          },
                                                              "headwaySeconds":  {
                                                                                     "type":  "integer",
                                                                                     "minimum":  60,
                                                                                     "maximum":  86400
                                                                                 },
                                                              "boardingModel":  {
                                                                                    "enum":  [
                                                                                                 "queue",
                                                                                                 "frequency"
                                                                                             ]
                                                                                },
                                                              "exactTimes":  {
                                                                                 "type":  "boolean"
                                                                             }
                                                          }
                                       },
                  "fareProduct":  {
                                      "type":  "object",
                                      "additionalProperties":  false,
                                      "required":  [
                                                       "fareProductId",
                                                       "nameTh",
                                                       "currency"
                                                   ],
                                      "properties":  {
                                                         "fareProductId":  {
                                                                               "$ref":  "#/$defs/id"
                                                                           },
                                                         "nameTh":  {
                                                                        "type":  "string",
                                                                        "minLength":  1
                                                                    },
                                                         "currency":  {
                                                                          "type":  "string",
                                                                          "pattern":  "^[A-Z]{3}$"
                                                                      }
                                                     }
                                  },
                  "fareRule":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "fareRuleId",
                                                    "fareProductId",
                                                    "routeId",
                                                    "amountMinor"
                                                ],
                                   "properties":  {
                                                      "fareRuleId":  {
                                                                         "$ref":  "#/$defs/id"
                                                                     },
                                                      "fareProductId":  {
                                                                            "$ref":  "#/$defs/id"
                                                                        },
                                                      "routeId":  {
                                                                      "$ref":  "#/$defs/id"
                                                                  },
                                                      "originLocationId":  {
                                                                               "anyOf":  [
                                                                                             {
                                                                                                 "$ref":  "#/$defs/id"
                                                                                             },
                                                                                             {
                                                                                                 "type":  "null"
                                                                                             }
                                                                                         ]
                                                                           },
                                                      "destinationLocationId":  {
                                                                                    "anyOf":  [
                                                                                                  {
                                                                                                      "$ref":  "#/$defs/id"
                                                                                                  },
                                                                                                  {
                                                                                                      "type":  "null"
                                                                                                  }
                                                                                              ]
                                                                                },
                                                      "amountMinor":  {
                                                                          "type":  "integer",
                                                                          "minimum":  0
                                                                      }
                                                  }
                               },
                  "transferRule":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "transferRuleId",
                                                        "fromLocationId",
                                                        "toLocationId",
                                                        "minimumTransferSeconds",
                                                        "maximumTransferSeconds",
                                                        "throughBooking",
                                                        "baggageTransfer"
                                                    ],
                                       "properties":  {
                                                          "transferRuleId":  {
                                                                                 "$ref":  "#/$defs/id"
                                                                             },
                                                          "fromLocationId":  {
                                                                                 "$ref":  "#/$defs/id"
                                                                             },
                                                          "toLocationId":  {
                                                                               "$ref":  "#/$defs/id"
                                                                           },
                                                          "minimumTransferSeconds":  {
                                                                                         "type":  "integer",
                                                                                         "minimum":  0
                                                                                     },
                                                          "maximumTransferSeconds":  {
                                                                                         "type":  "integer",
                                                                                         "minimum":  0
                                                                                     },
                                                          "throughBooking":  {
                                                                                 "type":  "boolean"
                                                                             },
                                                          "baggageTransfer":  {
                                                                                  "type":  "boolean"
                                                                              },
                                                          "fromOperatorId":  {
                                                                                 "$ref":  "#/$defs/id"
                                                                             },
                                                          "toOperatorId":  {
                                                                               "$ref":  "#/$defs/id"
                                                                           },
                                                          "fromServiceMode":  {
                                                                                  "type":  "string",
                                                                                  "enum":  [
                                                                                               "fixed",
                                                                                               "frequency"
                                                                                           ]
                                                                              },
                                                          "toServiceMode":  {
                                                                                "type":  "string",
                                                                                "enum":  [
                                                                                             "fixed",
                                                                                             "frequency"
                                                                                         ]
                                                                            },
                                                          "fromServiceId":  {
                                                                                "$ref":  "#/$defs/id"
                                                                            },
                                                          "toServiceId":  {
                                                                              "$ref":  "#/$defs/id"
                                                                          }
                                                      }
                                   }
              }
}
