{
  "projectIdPattern": "^demo-",
  "requiredEnvironment": {
    "FIREBASE_DATABASE_EMULATOR_HOST": "host:port without protocol"
  },
  "forbidden": [
    "production project id",
    "application default production credential",
    "direct browser write",
    "firebase deploy",
    "firebase use production"
  ],
  "lockedBasePath": "data/erpDataCenter",
  "limits": {
    "maxImportPackageBytes": 26214400,
    "maxEntityRecords": 50000,
    "maxChunkBytes": 5242880,
    "maxChunkLeafPaths": 5000
  }
}