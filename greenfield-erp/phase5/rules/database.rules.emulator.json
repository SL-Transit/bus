{
  "rules": {
    ".read": false,
    ".write": false,
    "data": {
      "erpDataCenter": {
        ".read": false,
        ".write": false,
        "publication": {
          "history": { ".indexOn": ["occurredAt", "toVersionId"] }
        },
        "audit": {
          "events": { ".indexOn": ["eventType", "entityId", "occurredAt"] }
        }
      }
    },
    "publishedReadModels": {
      ".read": false,
      ".write": false,
      "versions": {
        ".indexOn": ["manifest/status", "manifest/createdAt"]
      }
    }
  }
}