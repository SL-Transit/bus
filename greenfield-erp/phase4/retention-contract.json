{
  "version": "greenfield-retention-v1",
  "ownerApprovalRequired": true,
  "policyVariables": {
    "importJobRetentionHours": { "type": "integer", "minimum": 1, "maximum": 8760, "alsoAppliesTo": ["draftValidationJobs"] },
    "abandonedDraftRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "cleanupStartDate": { "type": "date", "format": "YYYY-MM-DD" },
    "batchSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maxDaysPerRun": { "type": "integer", "minimum": 1, "maximum": 31 },
    "leaseSeconds": { "type": "integer", "minimum": 30, "maximum": 1800 }
  },
  "resources": ["importJobs", "draftValidationJobs", "uploadAuthorizations", "abandonedDrafts"],
  "protected": ["review_requested", "approved", "published_current", "rollback_window", "legal_hold", "protectedFromCleanup=true"],
  "expiryIndex": "data/erpDataCenter/maintenance/expiryBuckets/{YYYY-MM-DD}/{resourceType}/{resourceId}",
  "cleanupOrder": ["verify status and lease", "delete quarantined source", "delete validation/import job", "delete draft entity groups", "delete job or draft metadata", "append compact audit event"],
  "storageLifecycle": { "status": "proposal_only", "productionRuleRequiresSeparateOwnerApproval": true }
}