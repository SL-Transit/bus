{
  "phase": 4,
  "status": "emulator_only",
  "projectIdPattern": "^demo-",
  "function": {
    "name": "greenfieldErpCommand",
    "region": "asia-southeast1",
    "minInstances": 0,
    "maxInstances": 3,
    "concurrency": 10,
    "timeoutSeconds": 30,
    "memory": "256MiB"
  },
  "authentication": {
    "customClaims": ["role"],
    "fineGrainedPath": "data/erpDataCenter/access/accounts/{uid}"
  },
  "implementedCommands": ["import.validate"],
  "reservedCommands": ["draft.save", "review.request", "approval.decide"],
  "limits": {
    "maxCommandBytes": 27262976,
    "maxRequestsPerInstanceWindow": 20,
    "windowMilliseconds": 60000
  },
  "forbidden": [
    "production project id",
    "production credential",
    "direct browser database write",
    "publish command",
    "firebase deploy"
  ]
}