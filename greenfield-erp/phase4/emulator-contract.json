{
  "phase": "6A",
  "status": "emulator_only",
  "projectIdPattern": "^demo-",
  "commands": {
    "implemented": [
      "upload.authorize",
      "import.start",
      "import.status",
      "draft.save",
      "review.request",
      "approval.decide"
    ],
    "forbidden": ["publish", "publication.activate", "published.pointer.switch"]
  },
  "functions": {
    "greenfieldErpCommand": {
      "type": "https",
      "minInstances": 0,
      "maxInstances": 3,
      "concurrency": 10,
      "timeoutSeconds": 30,
      "memory": "256MiB"
    },
    "greenfieldImportWorker": {
      "type": "task",
      "minInstances": 0,
      "maxInstances": 2,
      "concurrency": 1,
      "timeoutSeconds": 540,
      "memory": "512MiB",
      "maxConcurrentDispatches": 2,
      "maxAttempts": 5
    },
    "greenfieldRetentionCleanup": {
      "type": "schedule",
      "minInstances": 0,
      "maxInstances": 1,
      "concurrency": 1,
      "timeoutSeconds": 120,
      "memory": "256MiB"
    }
  },
  "limits": {
    "maxGatewayCommandBytes": 1048576,
    "maxStagedSourceBytes": 26214400,
    "maxDraftSaveBytes": 524288,
    "maxDraftOperationsPerCommand": 100,
    "maxRequestsPerInstanceWindow": 20,
    "windowMilliseconds": 60000,
    "uploadAuthorizationTtlSeconds": 900,
    "workflowLockSeconds": 60
  },
  "retention": {
    "resources": ["uploadAuthorizations", "importJobs", "abandonedDrafts"],
    "storageLifecycleStatus": "proposal_only"
  },
  "authorization": {
    "customClaims": ["role"],
    "fineGrainedPath": "data/erpDataCenter/access/accounts/{uid}",
    "separationOfDuties": "creator_or_last_editor_cannot_approve"
  },
  "browser": {
    "directRtdbWrite": false,
    "quarantineUpload": "authorized target only",
    "productionEndpointConfigured": false
  },
  "forbiddenEnvironment": [
    "production project id",
    "production credential",
    "direct browser database write",
    "firebase deploy",
    "publish command",
    "consumer cutover"
  ]
}